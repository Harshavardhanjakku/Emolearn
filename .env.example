## Example environment variables (copy to `.env` and fill in)
## Keep `.env` uncommitted.

# Backend (Python) Groq key (server-side usage)
GROQ_API_KEY=your_groq_api_key_here

# Frontend (Vite) Groq key (client-side usage)
# WARNING: anything in VITE_* is bundled into the frontend build.
VITE_GROQ_API_KEY=your_groq_api_key_here

